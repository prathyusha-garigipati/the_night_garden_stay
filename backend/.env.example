# Copy this file to .env and fill values before running the server locally
# Example MongoDB connection strings:
# - MongoDB Atlas (recommended): mongodb+srv://<user>:<password>@cluster0.abcd.mongodb.net/the_night_garden?retryWrites=true&w=majority
# - Local MongoDB: mongodb://localhost:27017/the_night_garden

MONGO_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/the_night_garden?retryWrites=true&w=majority"
# Optional: alternate env var name supported by server (MONGODB_URI)
# MONGODB_URI="..."

# Port the server should listen on (defaults to 5000)
PORT=5000
